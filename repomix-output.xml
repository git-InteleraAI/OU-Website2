.publications-badge {
  display: inline-block;
  margin-bottom: 14px;
  padding: 7px 17px;
  border: 1px solid rgba(226, 194, 117, 0.55);
  border-radius: 30px;
  background: rgba(184, 137, 43, 0.13);
  color: var(--gold-light);
  font-size: 11px;
  font-weight: 800;
  letter-spacing: 3px;
}

.publications-hero h1 {
  margin: 0;
  font-family: "Playfair Display", Georgia, serif;
  font-size: clamp(40px, 5vw, 60px);
  line-height: 1.1;
}

.publications-hero p {
  max-width: 720px;
  margin: 18px auto 0;
  color: rgba(255, 255, 255, 0.88);
  font-size: 15px;
  line-height: 1.8;
}

.publications-content {
  width: 100%;
  background: #ffffff;
}

.publications-container {
  width: 100%;
  margin: auto;
}

.publication-section {
  padding: 72px 6% 82px;
  background: #ffffff;
}

.publication-section-soft {
  background: #f8fafc;
  border-top: 1px solid #e8edf3;
  border-bottom: 1px solid #e8edf3;
}

.publication-section-heading {
  width: min(980px, 100%);
  margin: 0 auto 34px;
  text-align: center;
}

.publication-section-heading > span {
  display: inline-block;
  margin-bottom: 10px;
  color: var(--gold);
  font-size: 11px;
  font-weight: 800;
  letter-spacing: 2.2px;
  text-transform: uppercase;
}

.publication-section-heading h2 {
  margin: 0;
  color: var(--navy);
  font-family: "Playfair Display", Georgia, serif;
  font-size: clamp(29px, 3.3vw, 43px);
  line-height: 1.2;
}

.publication-section-heading p {
  max-width: 760px;
  margin: 14px auto 0;
  color: var(--text-light);
  font-size: 14.5px;
  line-height: 1.75;
}

.publication-subsection {
  margin-top: 62px;
}

.publication-table-card {
  width: min(1500px, 100%);
  margin: 0 auto;
  overflow: hidden;
  border: 1px solid #dfe6ee;
  border-radius: 15px;
  background: #ffffff;
  box-shadow: 0 10px 30px rgba(10, 31, 68, 0.06);
}

.publication-table-scroll {
  width: 100%;
  overflow-x: auto;
  -webkit-overflow-scrolling: touch;
}

.publication-table {
  width: 100%;
  min-width: 1180px;
  border-collapse: separate;
  border-spacing: 0;
  table-layout: auto;
  color: #2d3a4d;
  font-size: 12.5px;
}

.publication-table th,
.publication-table td {
  padding: 13px 12px;
  border-right: 1px solid #e3e8ee;
  border-bottom: 1px solid #e3e8ee;
  vertical-align: top;
  line-height: 1.55;
}

.publication-table th:last-child,
.publication-table td:last-child {
  border-right: none;
}

.publication-table thead th {
  position: sticky;
  top: 0;
  z-index: 1;
  background: #102a56;
  color: #ffffff;
  font-size: 11px;
  font-weight: 800;
  letter-spacing: 0.25px;
  text-align: left;
  white-space: nowrap;
}

.publication-table tbody tr:nth-child(even) {
  background: #f8fafc;
}

.publication-table tbody tr:hover {
  background: #f1f6fb;
}

.publication-table td:first-child {
  width: 52px;
  text-align: center;
  font-weight: 800;
  color: var(--navy);
}

.publication-table td:nth-child(2) {
  min-width: 220px;
  color: #20344e;
  font-weight: 650;
}

.publication-table td {
  min-width: 110px;
}

.publication-table tbody tr:last-child td {
  border-bottom: none;
}

@media (max-width: 760px) {
  .publications-hero {
    padding: 56px 6%;
  }

  .publication-section {
    padding: 54px 4.5% 66px;
  }

  .publication-section-heading {
    margin-bottom: 26px;
  }

  .publication-subsection {
    margin-top: 48px;
  }

  .publication-table {
    min-width: 1060px;
    font-size: 12px;
  }

  .publication-table th,
  .publication-table td {
    padding: 11px 10px;
  }
}
</file>

