<file path="src/components/ImageSlider.jsx">
import { useEffect, useState } from "react";

const images = [
    "/images/slider/OU_eng.png",
    "/images/slider/Technology.png",
    "/images/slider/PM.png",
    "/images/slider/Vice.png",
];

const ImageSlider = () => {
    const [currentImage, setCurrentImage] = useState(0);

    useEffect(() => {
        const interval = setInterval(() => {
            setCurrentImage((previous) =>
                previous === images.length - 1
                    ? 0
                    : previous + 1
            );
        }, 4000);

        return () => clearInterval(interval);
    }, []);

    const goToPrevious = () => {
        setCurrentImage((previous) =>
            previous === 0
                ? images.length - 1
                : previous - 1
        );
    };

    const goToNext = () => {
        setCurrentImage((previous) =>
            previous === images.length - 1
                ? 0
                : previous + 1
        );
    };

    return (
        <div className="slider">

            {images.map((image, index) => (
                <img
                    key={image}
                    src={image}
                    alt={`Slide ${index + 1}`}
                    className={`slider-image ${index === currentImage ? "active" : ""
                        }`}
                />
            ))}

            <div className="slider-overlay"></div>

            <div className="slider-content">
                <span className="slider-tag">
                    Welcome
                </span>

                <h2>
                    Inspiring Progress Through
                    <br />
                    Excellence & Innovation
                </h2>

                <p>
                    Building a stronger future through knowledge,
                    innovation and meaningful initiatives.
                </p>

                <button className="hero-button">
                    Explore More
                </button>
            </div>

            <button
                className="slider-arrow slider-arrow-left"
                onClick={goToPrevious}
            >
                ‹
            </button>

            <button
                className="slider-arrow slider-arrow-right"
                onClick={goToNext}
            >
                ›
            </button>

            <div className="slider-dots">

                {images.map((_, index) => (
                    <button
                        key={index}
                        className={`slider-dot ${index === currentImage ? "active" : ""
                            }`}
                        onClick={() => setCurrentImage(index)}
                    />
                ))}

            </div>

        </div>
    );
};

export default ImageSlider;
</file>

<file path="src/sections/Contact.css">
/* =========================================================
   CAIIC CONTACT PAGE
========================================================= */

.contact-page {
  width: 100%;
  min-height: 100vh;
  background: #ffffff;
  color: var(--text-dark);
}

/* HERO */

.contact-hero {
  position: relative;
  overflow: hidden;
  width: 100%;
  padding: 68px 6%;
  color: #ffffff;
  background:
    radial-gradient(circle at 88% 15%, rgba(226, 194, 117, 0.16), transparent 34%),
    linear-gradient(135deg, var(--navy-dark), var(--navy) 58%, var(--navy-light));
}

.contact-hero::after {
  content: "";
  position: absolute;
  width: 340px;
  height: 340px;
  right: -90px;
  top: -170px;
  border-radius: 50%;
  border: 62px solid rgba(255, 255, 255, 0.045);
}

.contact-hero-inner {
  position: relative;
  z-index: 2;
  width: min(1050px, 100%);
  margin: auto;
  text-align: center;
}

.contact-badge {
  display: inline-block;
  margin-bottom: 14px;
  padding: 7px 17px;
  border: 1px solid rgba(226, 194, 117, 0.55);
  border-radius: 30px;
  background: rgba(184, 137, 43, 0.13);
  color: var(--gold-light);
  font-size: 11px;
  font-weight: 800;
  letter-spacing: 3px;
}

.contact-hero h1 {
  margin: 0;
  font-family: "Playfair Display", Georgia, serif;
  font-size: clamp(40px, 5vw, 60px);
  line-height: 1.1;
}

.contact-hero p {
  max-width: 700px;
  margin: 16px auto 0;
  color: rgba(255, 255, 255, 0.86);
  font-size: 15px;
  line-height: 1.65;
}

/* CONTENT */

.contact-content {
  width: 100%;
  padding: 58px 6% 82px;
  background:
    linear-gradient(180deg, #f8fafc 0%, #ffffff 38%, #ffffff 100%);
}

.contact-container {
  width: min(1220px, 100%);
  margin: auto;
}

/* PROFESSOR PROFILE */

.contact-profile {
  width: min(850px, 100%);
  margin: 0 auto 38px;
  display: grid;
  grid-template-columns: 205px 1fr;
  align-items: center;
  gap: 34px;
  padding: 22px 30px;
  border: 1px solid var(--border);
  border-radius: 18px;
  background: #ffffff;
  box-shadow: var(--shadow-sm);
}

.contact-profile-photo-wrap {
  width: 190px;
  height: 190px;
  overflow: hidden;
  border-radius: 16px;
  background: #eef2f6;
  border: 4px solid #ffffff;
  box-shadow: 0 8px 24px rgba(10, 31, 68, 0.13);
}

.contact-profile-photo {
  width: 100%;
  height: 100%;
  object-fit: cover;
  object-position: center top;
}

.contact-profile-label {
  display: inline-block;
  margin-bottom: 10px;
  color: var(--gold);
  font-size: 11px;
  font-weight: 800;
  letter-spacing: 2.2px;
}

.contact-profile-info h2 {
  margin: 0 0 10px;
  color: var(--navy);
  font-family: "Playfair Display", Georgia, serif;
  font-size: clamp(27px, 3vw, 38px);
  line-height: 1.2;
}

.contact-profile-info p {
  margin: 0;
  color: var(--text-light);
  font-size: 15px;
  line-height: 1.7;
}

/* CONTACT CARDS */

.contact-cards {
  display: grid;
  grid-template-columns: 1.35fr 0.95fr 0.95fr;
  gap: 22px;
}

.contact-card {
  min-height: 215px;
  padding: 28px 26px;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: flex-start;
  border: 1px solid #e2e7ed;
  border-radius: 14px;
  background: #ffffff;
  text-align: center;
  box-shadow: 0 8px 24px rgba(10, 31, 68, 0.06);
  transition: transform 0.25s ease, box-shadow 0.25s ease;
}

.contact-card:hover {
  transform: translateY(-5px);
  box-shadow: 0 16px 35px rgba(10, 31, 68, 0.11);
}

.contact-icon {
  width: 58px;
  height: 58px;
  margin-bottom: 18px;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background: #edf4fa;
  color: var(--navy);
}

.contact-icon svg {
  width: 27px;
  height: 27px;
  fill: none;
  stroke: currentColor;
  stroke-width: 1.8;
  stroke-linecap: round;
  stroke-linejoin: round;
}

.contact-card h3 {
  margin: 0 0 13px;
  color: var(--navy);
  font-size: 19px;
  line-height: 1.3;
}

.contact-card p,
.contact-card a {
  margin: 0;
  color: #536176;
  font-size: 14px;
  line-height: 1.75;
  text-decoration: none;
}

.contact-card a {
  color: var(--navy-light);
  font-weight: 600;
  word-break: break-word;
}

.contact-card a:hover {
  color: var(--gold);
}

.contact-card p span {
  color: #718096;
}

/* RESPONSIVE */

@media (max-width: 950px) {
  .contact-cards {
    grid-template-columns: 1fr;
  }

  .contact-card {
    min-height: auto;
  }
}

@media (max-width: 700px) {
  .contact-hero {
    padding: 54px 6%;
  }

  .contact-content {
    padding: 48px 5% 64px;
  }

  .contact-profile {
    grid-template-columns: 1fr;
    gap: 20px;
    padding: 24px;
    text-align: center;
  }

  .contact-profile-photo-wrap {
    width: 160px;
    height: 160px;
    margin: auto;
  }

  .contact-card {
    padding: 26px 22px;
  }
}

/* FINAL CONTACT SPACING REFINEMENTS */

.contact-card:first-child p {
  max-width: 470px;
  margin-left: auto;
  margin-right: auto;
}

.contact-card:nth-child(3) p span {
  display: inline-block;
  margin-top: 3px;
  font-size: 12.5px;
  color: #7a8798;
}

@media (max-width: 950px) {
  .contact-card:first-child p {
    max-width: 620px;
  }
}
