<file path="src/sections/CoursesWorkshops.css">
/* =========================================================
   CAIIC COURSES & WORKSHOPS PAGE
========================================================= */

.cw-page {
  width: 100%;
  min-height: 100vh;
  background: #ffffff;
  color: var(--text-dark);
}

/* =========================================================
   HERO
========================================================= */

.cw-hero {
  position: relative;

  width: 100%;

  overflow: hidden;

  padding: 70px 6%;

  color: #ffffff;

  background:
    radial-gradient(
      circle at 86% 18%,
      rgba(226, 194, 117, 0.14),
      transparent 34%
    ),
    linear-gradient(
      135deg,
      var(--navy-dark),
      var(--navy) 58%,
      var(--navy-light)
    );
}

.cw-hero::after {
  content: "";

  position: absolute;

  width: 350px;
  height: 350px;

  right: -105px;
  top: -175px;

  border-radius: 50%;

  border: 65px solid rgba(255, 255, 255, 0.045);
}

.cw-hero-inner {
  position: relative;

  z-index: 2;

  width: min(900px, 100%);

  margin: auto;

  text-align: center;
}

.cw-badge {
  display: inline-block;

  margin-bottom: 14px;

  padding: 7px 17px;

  border: 1px solid rgba(226, 194, 117, 0.55);

  border-radius: 30px;

  background: rgba(184, 137, 43, 0.13);

  color: var(--gold-light);

  font-size: 11px;

  font-weight: 800;

  letter-spacing: 3px;
}

.cw-hero h1 {
  margin: 0;

  font-family: "Playfair Display", Georgia, serif;

  font-size: clamp(40px, 5vw, 60px);

  line-height: 1.1;
}

.cw-hero p {
  max-width: 760px;

  margin: 18px auto 0;

  color: rgba(255, 255, 255, 0.88);

  font-size: 15px;

  line-height: 1.8;
}

/* =========================================================
   COMMON SECTION STYLES
========================================================= */

.cw-section {
  width: 100%;

  padding: 72px 6% 88px;
}

.cw-section-community {
  background: #ffffff;
}

.cw-section-skills {
  background: #f8fafc;

  border-top: 1px solid #e8edf3;
}

.cw-section-internship {
  padding: 55px 6% 75px;

  background: #f8fafc;

  border-top: 1px solid #e8edf3;
}

.cw-container {
  width: min(1240px, 100%);

  margin: auto;
}

.cw-heading {
  max-width: 820px;

  margin: 0 auto 38px;

  text-align: center;
}

.cw-heading-left {
  max-width: none;

  margin-left: 0;

  text-align: left;
}

.cw-heading > span {
  display: inline-block;

  margin-bottom: 10px;

  color: var(--gold);

  font-size: 11px;

  font-weight: 800;

  letter-spacing: 2.4px;
}

.cw-heading h2 {
  margin: 0;

  color: var(--navy);

  font-family: "Playfair Display", Georgia, serif;

  font-size: clamp(31px, 3.6vw, 46px);

  line-height: 1.2;
}

.cw-kicker {
  display: inline-block;

  margin-bottom: 9px;

  color: var(--gold);

  font-size: 10.5px;

  font-weight: 800;

  letter-spacing: 2px;
}

.cw-caption {
  margin: 0 0 14px;

  color: #748196;

  font-size: 11.5px;

  line-height: 1.55;
}

/* =========================================================
   BRINGING THE COMMUNITY TOGETHER
========================================================= */

.cw-event-grid {
  display: grid;

  grid-template-columns: repeat(2, 1fr);

  gap: 28px;

  align-items: stretch;
}

.cw-event-card {
  overflow: hidden;

  border: 1px solid #e0e6ed;

  border-radius: 18px;

  background: #ffffff;

  box-shadow:
    0 12px 30px rgba(10, 31, 68, 0.07);
}

.cw-event-image-wrap {
  width: 100%;

  aspect-ratio: 16 / 9;

  overflow: hidden;

  background: #eef2f6;
}

.cw-event-image {
  width: 100%;
  height: 100%;

  object-fit: cover;

  transition:
    transform 0.4s ease;
}

.cw-event-card:hover .cw-event-image {
  transform: scale(1.035);
}

.cw-event-body {
  padding: 24px 26px 28px;
}

.cw-event-body h3 {
  margin: 0 0 13px;

  color: var(--navy);

  font-size: 20px;

  line-height: 1.35;
}

.cw-event-body p:not(.cw-caption) {
  margin: 0 0 12px;

  color: var(--text-light);

  font-size: 14px;

  line-height: 1.8;

  text-align: justify;

  text-justify: inter-word;
}

.cw-event-body p:last-child {
  margin-bottom: 0;
}

/* =========================================================
   BUILDING INDUSTRY-READY TALENT
========================================================= */

.cw-conclave-layout {
  display: grid;

  grid-template-columns: 1.45fr 0.8fr;

  gap: 34px;

  align-items: center;

  margin-bottom: 34px;
}

.cw-conclave-image-column {
  min-width: 0;
}

.cw-conclave-image {
  display: block;

  width: 100%;

  max-height: 390px;

  object-fit: cover;

  border-radius: 16px;

  border: 1px solid #dde4eb;

  box-shadow:
    0 12px 32px rgba(10, 31, 68, 0.08);
}

.cw-conclave-image-column .cw-caption {
  margin-top: 9px;

  margin-bottom: 0;
}

.cw-conclave-copy {
  padding: 10px 0;
}

.cw-conclave-copy h3 {
  margin: 0 0 14px;

  color: var(--navy);

  font-family: "Playfair Display", Georgia, serif;

  font-size: clamp(25px, 2.8vw, 34px);

  line-height: 1.25;
}

.cw-conclave-copy p {
  margin: 0;

  color: var(--text-light);

  font-size: 14px;

  line-height: 1.8;
}

/* HIGHLIGHT CARDS */

.cw-highlight-grid {
  display: grid;

  grid-template-columns: repeat(3, 1fr);

  gap: 18px;
}

.cw-highlight-card {
  min-height: 240px;

  padding: 26px;

  border: 1px solid #e2e6ec;

  border-radius: 15px;

  background: #f4f0e6;
}

.cw-highlight-card > span {
  display: inline-block;

  margin-bottom: 9px;

  color: var(--gold);

  font-size: 10px;

  font-weight: 800;

  letter-spacing: 1.8px;
}

.cw-highlight-number {
  margin-bottom: 4px;

  color: var(--navy);

  font-family: "Playfair Display", Georgia, serif;

  font-size: 48px;

  font-weight: 800;

  line-height: 1;
}

.cw-highlight-card h3 {
  margin: 0 0 11px;

  color: var(--navy);

  font-size: 18px;

  line-height: 1.35;
}

.cw-highlight-card p {
  margin: 0;

  color: var(--text-light);

  font-size: 13.5px;

  line-height: 1.75;
}

.cw-closing-note {
  margin: 28px 0 0;

  color: var(--text-light);

  font-size: 14px;

  line-height: 1.8;
}

/* =========================================================
   INTERNSHIP & SKILL DEVELOPMENT
========================================================= */

.cw-internship-layout {
  display: grid;

  grid-template-columns: 0.9fr 1.1fr;

  gap: 45px;

  align-items: center;

  padding: 42px;

  background: #ffffff;

  border: 1px solid #e3e8ee;

  border-radius: 20px;

  box-shadow:
    0 14px 40px rgba(10, 31, 68, 0.08);
}

.cw-internship-content {
  min-width: 0;
}

.cw-internship-content h2 {
  margin: 0 0 18px;

  color: var(--navy);

  font-family: "Playfair Display", Georgia, serif;

  font-size: clamp(30px, 3.5vw, 44px);

  line-height: 1.16;
}

.cw-internship-content p {
  margin: 0;

  color: var(--text-light);

  font-size: 15px;

  line-height: 1.8;

  text-align: left;
}

.cw-internship-image-wrap {
  width: 100%;

  overflow: hidden;

  border: 1px solid #e0e6ed;

  border-radius: 16px;

  background: #ffffff;

  box-shadow:
    0 8px 25px rgba(10, 31, 68, 0.08);
}

.cw-internship-image {
  display: block;

  width: 100%;

  height: auto;

  object-fit: contain;

  object-position: center;
}

/* =========================================================
   RESPONSIVE
========================================================= */

@media (max-width: 900px) {
  .cw-event-grid,
  .cw-conclave-layout,
  .cw-highlight-grid,
  .cw-internship-layout {
    grid-template-columns: 1fr;
  }

  .cw-heading-left {
    text-align: center;
  }

  .cw-conclave-copy {
    padding-top: 0;
  }

  .cw-highlight-card {
    min-height: auto;
  }

  .cw-internship-layout {
    gap: 28px;

    padding: 30px;
  }

  .cw-internship-content {
    text-align: center;
  }

  .cw-internship-content p {
    text-align: left;
  }
}

@media (max-width: 600px) {
  .cw-hero {
    padding: 56px 6%;
  }

  .cw-section {
    padding: 54px 5% 68px;
  }

  .cw-section-internship {
    padding: 44px 5% 60px;
  }

  .cw-event-body {
    padding: 21px 20px 24px;
  }

  .cw-event-body p:not(.cw-caption) {
    text-align: left;
  }

  .cw-internship-layout {
    padding: 22px;

    border-radius: 16px;
  }

  .cw-internship-content h2 {
    font-size: 30px;
  }

  .cw-internship-content p {
    font-size: 14px;

    line-height: 1.72;
  }
}
</file>

