========================================================= */

.infrastructure-page {
  width: 100%;
  min-height: 100vh;
  background: #ffffff;
}

/* HERO */

.infrastructure-hero {
  position: relative;

  width: 100%;

  padding:
    65px 6%;

  overflow: hidden;

  color: #ffffff;

  background:
    radial-gradient(
      circle at 86% 18%,
      rgba(226, 194, 117, 0.14),
      transparent 34%
    ),
    linear-gradient(
      135deg,
      var(--navy-dark),
      var(--navy) 58%,
      var(--navy-light)
    );
}

.infrastructure-hero::after {
  content: "";

  position: absolute;

  width: 370px;
  height: 370px;

  right: -100px;
  top: -180px;

  border-radius: 50%;

  border:
    65px solid rgba(255, 255, 255, 0.05);
}

.infrastructure-hero-inner {
  position: relative;

  z-index: 2;

  width: min(1000px, 100%);

  margin: auto;

  text-align: center;
}

.infrastructure-badge {
  display: inline-block;

  margin-bottom: 13px;

  padding:
    7px 17px;

  border:
