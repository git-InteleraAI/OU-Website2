    border-bottom: 1px solid var(--border);
  }
}

@media (max-width: 700px) {
  .quick-info-wrapper {
    width: 94%;
    margin-top: 24px;
    border-radius: 14px;
  }

  .quick-info-card {
    padding: 28px 22px;
    gap: 14px;
  }

  .info-icon {
    flex-basis: 44px;
    width: 44px;
    height: 44px;
  }

  .quick-info-card h3 {
    font-size: 23px;
    margin-bottom: 13px;
  }

  .quick-info-card p,
  .mission-list li {
    font-size: 13.5px;
    line-height: 1.75;
  }

  .mission-list {
    padding-left: 18px;
  }
}


/* =========================================================
   CAIIC ABOUT PAGE
========================================================= */
.caiic-about-page {
  width: 100%;
  background: #ffffff;
  color: var(--text-dark);
}

.caiic-about-hero {
  width: 100%;
  padding: clamp(60px, 8vw, 100px) 6%;
  position: relative;
  overflow: hidden;
  color: #ffffff;
  background:
    radial-gradient(circle at 85% 15%, rgba(184, 137, 43, 0.28), transparent 45%),
    linear-gradient(135deg, var(--navy-dark), var(--navy) 55%, var(--navy-light));
}

.caiic-about-hero::before {
  content: "";
  position: absolute;
  width: 380px;
  height: 380px;
  right: -95px;
  top: -170px;
  border-radius: 50%;
  border: 68px solid rgba(226, 194, 117, 0.07);
}

.caiic-about-hero::after {
  content: "";
  position: absolute;
  width: 240px;
  height: 240px;
  left: -100px;
  bottom: -150px;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.04);
}

.caiic-about-hero-inner {
  width: min(1180px, 100%);
  margin: auto;
  position: relative;
  z-index: 2;
  text-align: center;
}

.caiic-about-badge {
  display: inline-block;
  margin-bottom: 18px;
  padding: 8px 20px;
  border-radius: 40px;
  border: 1px solid var(--gold-light);
  color: var(--gold-light);
  background: rgba(184, 137, 43, 0.12);
  font-size: 11px;
  font-weight: 800;
  letter-spacing: 3px;
}

.caiic-about-hero h1 {
  max-width: 1000px;
  margin: 0 auto;
  font-family: "Playfair Display", Georgia, serif;
  font-size: clamp(30px, 4.3vw, 58px);
  line-height: 1.15;
  font-weight: 700;
}

.caiic-about-hero p {
  margin: 18px auto 0;
  font-size: clamp(14px, 1.3vw, 17px);
  color: rgba(255, 255, 255, 0.88);
}

.caiic-section {
  width: 100%;
  padding: clamp(60px, 7vw, 90px) 6%;
}

.caiic-container {
  width: min(1220px, 100%);
  margin: auto;
}

.caiic-section-soft {
  background: var(--soft);
  border-top: 1px solid var(--border);
  border-bottom: 1px solid var(--border);
}

.caiic-section-label {
  display: inline-block;
  margin-bottom: 12px;
  color: var(--gold);
  font-size: 11px;
  font-weight: 800;
  letter-spacing: 2.5px;
  text-transform: uppercase;
}

.caiic-accent-line {
  width: 70px;
  height: 4px;
  margin-top: 24px;
  border-radius: 10px;
  background: linear-gradient(90deg, var(--gold), var(--gold-light));
}

/* INTRO + COLLABORATION */
.caiic-intro-grid,
.caiic-collaboration-grid {
  display: grid;
  grid-template-columns: 0.9fr 1.1fr;
  gap: clamp(32px, 6vw, 80px);
  align-items: start;
}

.caiic-intro-heading h2,
.caiic-collaboration-heading h2 {
  margin: 0;
  max-width: 540px;
  font-family: "Playfair Display", Georgia, serif;
  color: var(--navy);
  font-size: clamp(28px, 3.3vw, 46px);
  line-height: 1.18;
}

.caiic-intro-content,
.caiic-collaboration-content {
  padding-left: 28px;
  border-left: 3px solid var(--gold-light);
}

.caiic-intro-content p,
.caiic-collaboration-content p {
  margin: 0 0 20px;
  color: var(--text-light);
  font-size: 15.5px;
  line-height: 1.9;
}

/* CENTER HEADINGS */
.caiic-heading-center {
  max-width: 760px;
  margin: 0 auto 48px;
  text-align: center;
}

.caiic-heading-center h2 {
  margin: 0 0 15px;
  color: var(--navy);
  font-family: "Playfair Display", Georgia, serif;
  font-size: clamp(28px, 3.2vw, 44px);
  line-height: 1.2;
}

.caiic-heading-center p {
  max-width: 690px;
  margin: auto;
  color: var(--text-light);
  font-size: 15px;
  line-height: 1.8;
}

/* CAPABILITY CARDS */
.caiic-cards-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 22px;
}

.caiic-card {
  min-height: 250px;
  padding: 30px 26px;
  border-radius: 14px;
  border: 1px solid var(--border);
  border-top: 4px solid var(--gold);
  background: #ffffff;
  box-shadow: var(--shadow-sm);
  transition: transform 0.3s ease, box-shadow 0.3s ease;
}

.caiic-card:hover {
  transform: translateY(-8px);
  box-shadow: var(--shadow);
}


.caiic-card h3 {
  margin: 0 0 12px;
  color: var(--navy);
  font-size: 18px;
  line-height: 1.35;
}

.caiic-card p {
  margin: 0;
  color: var(--text-light);
  font-size: 14px;
  line-height: 1.75;
}

/* LANDMARK ACHIEVEMENT */
.caiic-achievement-card {
  overflow: hidden;
  display: grid;
  grid-template-columns: 240px 1fr;
  border-radius: 20px;
  background: radial-gradient(circle at 10% 50%, rgba(184, 137, 43, 0.28), transparent 45%),
    linear-gradient(135deg, var(--navy-dark), var(--navy-light));
  box-shadow: var(--shadow);
  color: #ffffff;
}

.caiic-achievement-year {
  min-height: 280px;
  display: flex;
  justify-content: center;
  align-items: center;
  background: rgba(255, 255, 255, 0.05);
  border-right: 2px solid rgba(226, 194, 117, 0.4);
  font-family: "Playfair Display", Georgia, serif;
  font-size: clamp(48px, 5vw, 64px);
  font-weight: 700;
  color: var(--gold-light);
}

.caiic-achievement-content {
  display: flex;
  flex-direction: column;
  justify-content: center;
  padding: 45px 55px;
}

.caiic-label-light {
  color: var(--gold-light);
}

.caiic-achievement-content h2 {
  margin: 0 0 16px;
  font-family: "Playfair Display", Georgia, serif;
  font-size: clamp(26px, 3.2vw, 42px);
}

.caiic-achievement-content p {
  max-width: 760px;
  margin: 0;
  color: rgba(255, 255, 255, 0.88);
  font-size: 15px;
  line-height: 1.9;
}

/* RESEARCH */
.caiic-research-section {
  width: 100%;
  padding: clamp(60px, 7vw, 90px) 6%;
  color: #ffffff;
  background: linear-gradient(180deg, var(--navy), var(--navy-dark));
}

.caiic-heading-light h2 {
  color: #ffffff;
}

.caiic-heading-light p {
  color: rgba(255, 255, 255, 0.78);
}

.caiic-research-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 16px;
}

.caiic-research-item {
  min-height: 100px;
  padding: 20px;
  display: flex;
  align-items: center;
  justify-content: center;
  text-align: center;
  border-radius: 10px;
  border: 1px solid rgba(255, 255, 255, 0.12);
  border-bottom: 3px solid var(--gold);
  background: rgba(255, 255, 255, 0.06);
  font-size: 14px;
  font-weight: 600;
  line-height: 1.5;
  transition: transform 0.25s ease, background 0.25s ease;
}

.caiic-research-item:hover {
  transform: translateY(-4px);
  background: rgba(226, 194, 117, 0.16);
}

/* FUTURE VISION */
.caiic-vision-section {
  width: 100%;
  padding: 0 6% clamp(60px, 7vw, 90px);
  background: #ffffff;
}

.caiic-vision-card {
  position: relative;
  max-width: 1220px;
  margin: auto;
  padding: clamp(40px, 5vw, 62px) clamp(24px, 6vw, 70px);
  border-radius: 20px;
  text-align: center;
  border: 1px solid var(--border);
  background: linear-gradient(135deg, #fffdf8, var(--soft));
  box-shadow: var(--shadow-sm);
}

.caiic-vision-card::before {
  content: "";
  position: absolute;
  top: 0;
  left: 50%;
  width: 120px;
  height: 5px;
  transform: translateX(-50%);
  border-radius: 0 0 6px 6px;
  background: linear-gradient(90deg, var(--gold), var(--gold-light));
}

.caiic-vision-card h2 {
  max-width: 800px;
  margin: 0 auto 21px;
  color: var(--navy);
  font-family: "Playfair Display", Georgia, serif;
  font-size: clamp(28px, 3.4vw, 46px);
  line-height: 1.2;
}

.caiic-vision-card p {
  max-width: 920px;
  margin: 0 auto 17px;
  color: var(--text-light);
  font-size: 15px;
  line-height: 1.9;
}

/* =========================================================
   SIMPLE GALLERY SLIDER
========================================================= */
.simple-gallery-page {
  width: 100%;
  margin: 0;
  padding: 0;
  background: #ffffff;
}

.gallery-slider {
  position: relative;
  width: 100%;
  height: calc(100svh - 230px);
  min-height: 450px;
  overflow: hidden;
  background: #ffffff;
}

.gallery-slide-image {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  object-fit: contain;
  object-position: center;
  background: #ffffff;
  opacity: 0;
  transform: translateX(45px);
  transition: opacity 0.8s ease, transform 0.8s ease;
}

.gallery-slide-image.active {
  opacity: 1;
  transform: translateX(0);
}

.gallery-arrow {
  position: absolute;
  top: 50%;
  z-index: 10;
  transform: translateY(-50%);
  width: 52px;
  height: 52px;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0;
  border: 1px solid rgba(255, 255, 255, 0.6);
  border-radius: 50%;
  background: rgba(10, 31, 68, 0.7);
  color: #ffffff;
  font-size: 34px;
  cursor: pointer;
  backdrop-filter: blur(6px);
  box-shadow: 0 6px 18px rgba(0, 0, 0, 0.18);
  transition: background 0.25s ease, box-shadow 0.25s ease;
}

.gallery-arrow:hover {
  background: var(--gold);
  box-shadow: 0 8px 24px rgba(0, 0, 0, 0.24);
}

.gallery-arrow-left {
  left: 28px;
}

.gallery-arrow-right {
  right: 28px;
}

.gallery-slider-dots {
  position: absolute;
  z-index: 10;
  left: 50%;
  bottom: 24px;
  transform: translateX(-50%);
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8px;
  padding: 9px 14px;
  border-radius: 30px;
  background: rgba(10, 31, 68, 0.5);
  backdrop-filter: blur(6px);
}

.gallery-slider-dot {
  width: 9px;
  height: 9px;
  margin: 0;
  padding: 0;
  border: none;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.65);
  cursor: pointer;
  transition: width 0.3s ease, background 0.3s ease;
}

.gallery-slider-dot:hover {
  background: #ffffff;
}

.gallery-slider-dot.active {
  width: 28px;
  border-radius: 12px;
  background: var(--gold-light);
}

.gallery-no-images {
  min-height: 500px;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 30px;
  color: var(--text-light);
  font-size: 16px;
  text-align: center;
  background: #ffffff;
}

/* =========================================================
   PLACEHOLDER PAGES
========================================================= */
.placeholder-page {
  min-height: 60vh;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 80px 6%;
  background: linear-gradient(180deg, var(--soft), #ffffff);
}

.placeholder-page-inner {
  width: min(800px, 100%);
  text-align: center;
}

.placeholder-page-inner span {
  display: inline-block;
  margin-bottom: 12px;
  color: var(--gold);
  font-size: 12px;
  font-weight: 800;
  letter-spacing: 3px;
}

.placeholder-page-inner h1 {
  margin: 0;
  color: var(--navy);
  font-family: "Playfair Display", serif;
  font-size: clamp(34px, 5vw, 58px);
}

.placeholder-page-inner p {
  margin-top: 16px;
  color: var(--text-light);
  font-size: 16px;
}

/* =========================================================
   RESPONSIVE
========================================================= */
@media (min-width: 1600px) {
  .header-container {
    min-height: 180px;
  }

  .header-logo {
    width: 125px;
    height: 125px;
  }

  .slider {
    height: clamp(560px, calc(100svh - 270px), 780px);
  }

  .gallery-slider {
    height: calc(100svh - 270px);
  }
}

@media (max-width: 1200px) {
  .navbar-container {
    justify-content: flex-start;
    flex-wrap: nowrap;
    overflow-x: auto;
    scrollbar-width: none;
  }

  .navbar-container::-webkit-scrollbar {
    display: none;
  }

  .nav-link {
    flex-shrink: 0;
  }
}

@media (max-width: 1050px) {

  .caiic-intro-grid,
  .caiic-collaboration-grid {
    grid-template-columns: 1fr;
    gap: 35px;
  }

  .caiic-cards-grid,
  .caiic-research-grid {
    grid-template-columns: repeat(2, 1fr);
  }

  .caiic-achievement-card {
    grid-template-columns: 180px 1fr;
  }
}

@media (max-width: 900px) {
  .header-container {
    grid-template-columns: 100px 1fr 100px;
    min-height: 130px;
    gap: 12px;
  }

  .header-logo {
    width: 80px;
    height: 80px;
  }

  .header-university-info h2 {
    font-size: 12px;
  }

  .header-university-info p {
    font-size: 11px;
  }

  .gallery-slider {
    height: calc(100svh - 200px);
    min-height: 420px;
  }

  .gallery-arrow {
    width: 44px;
    height: 44px;
    font-size: 29px;
  }

  .gallery-arrow-left {
    left: 15px;
  }

  .gallery-arrow-right {
    right: 15px;
  }

  .gallery-slider-dots {
    bottom: 18px;
  }
}

@media (max-width: 700px) {
  .caiic-about-hero h1 br {
    display: none;
  }

  .caiic-cards-grid,
  .caiic-research-grid {
    grid-template-columns: 1fr;
  }

  .caiic-card {
    min-height: auto;
  }

  .caiic-intro-content,
  .caiic-collaboration-content {
    padding-left: 18px;
  }

  .caiic-achievement-card {
    grid-template-columns: 1fr;
  }

  .caiic-achievement-year {
    min-height: 120px;
    border-right: none;
    border-bottom: 2px solid rgba(226, 194, 117, 0.4);
  }

  .caiic-achievement-content {
    padding: 34px 26px;
  }
}

@media (max-width: 600px) {
  .header-container {
    min-height: 100px;
    grid-template-columns: 62px 1fr 62px;
    gap: 8px;
  }

  .header-logo {
    width: 54px;
    height: 54px;
  }

  .header-title {
    font-size: 19px;
  }

  .header-small-title {
    font-size: 9px;
    letter-spacing: 2px;
  }

  .header-subtitle {
    font-size: 10px;
  }

  .header-university-info {
    margin-top: 7px;
  }

  .header-university-info h2 {
    font-size: 9px;
    line-height: 1.2;
  }

  .header-university-info p {
    font-size: 8px;
    line-height: 1.2;
  }

  .slider {
    height: 520px;
  }

  .slider-content {
    width: 78%;
  }

  .slider-content h2 br {
    display: none;
  }

  .slider-arrow {
    width: 36px;
    height: 36px;
    font-size: 24px;
  }

  .slider-arrow-left {
    left: 8px;
  }

  .slider-arrow-right {
    right: 8px;
  }

  .gallery-slider {
    height: calc(100svh - 180px);
    min-height: 380px;
  }

  .gallery-arrow {
    width: 36px;
    height: 36px;
    font-size: 24px;
  }

  .gallery-arrow-left {
    left: 6px;
  }

  .gallery-arrow-right {
    right: 6px;
  }

  .gallery-slider-dots {
    bottom: 12px;
    gap: 6px;
    padding: 7px 10px;
  }

  .gallery-slider-dot {
    width: 7px;
    height: 7px;
  }

  .gallery-slider-dot.active {
    width: 22px;
  }
}

/* =========================================================
